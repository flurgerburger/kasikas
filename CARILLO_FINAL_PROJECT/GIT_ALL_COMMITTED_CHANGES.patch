 @media (max-width: 760px) { .site-header { padding: 20px 6vw; }.site-nav { gap: 15px; }.site-nav > a:first-child, .nav-user { display: none; }.auth-layout { display: block; min-height: auto; padding: 65px 8vw; }.auth-intro h1 { font-size: 58px; }.film-strip { margin: 45px 0 55px; }.auth-panel { border-left: 0; border-top: 1px solid var(--line); padding: 42px 0 15px; }.quote { margin-top: 45px; }.home-hero { grid-template-columns: 1fr; }.hero-copy { min-height: 520px; padding: 65px 8vw; }.hero-art { min-height: 390px; }.section-block { padding: 65px 8vw 80px; }.section-heading h2 { font-size: 32px; }.film-grid { grid-template-columns: 1fr; }.film-card { min-height: 250px; }.community-band { display: block; padding: 60px 8vw; }.community-band p:last-child { margin-top: 30px; }.site-footer { display: block; line-height: 1.8; }.site-footer .mono { display: block; } }
+
+
+/* ==========================================================================
+   Kasikas Interactive Catalog, Detail, Video Player & Ticketing Passes
+   ========================================================================== */
+.film-card { display: block; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; cursor: pointer; }
+.film-card:hover { transform: translateY(-4px); box-shadow: 0 10px 25px rgba(0, 0, 0, .4); }
+.film-card:hover .card-arrow { transform: translate(3px, -3px); }
+.card-arrow { transition: transform .2s ease; }
+.empty-state-block { grid-column: 1 / -1; padding: 60px 40px; border: 1px dashed var(--line); background: var(--surface); text-align: center; }
+.empty-state-block h3 { margin: 0 0 10px; font-size: 26px; }
+.empty-state-block .panel-copy { margin: 0 auto; }
+
+/* Film Detail View */
+.film-detail-container { max-width: 1240px; margin: 0 auto; padding: 45px 5vw 90px; }
+.detail-nav-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
+.detail-layout { display: grid; grid-template-columns: 1fr 380px; gap: 6vw; align-items: start; }
+.detail-title { margin: 0 0 8px; font-size: clamp(42px, 5vw, 76px); line-height: .95; letter-spacing: -.05em; font-weight: 600; }
+.detail-subtitle { margin: 0 0 20px; font-size: 13px; color: var(--lime); }
+.detail-director { margin: 0 0 45px; font-size: 16px; color: #b8aa95; }
+.detail-block { margin-bottom: 45px; border-top: 1px solid var(--line); padding-top: 25px; }
+.detail-heading { font-size: 20px; margin: 0 0 16px; letter-spacing: -.03em; }
+.detail-prose { font-size: 15px; line-height: 1.7; color: #d6cab6; max-width: 620px; }
+.detail-prose p { margin-top: 0; }
+.credits-box { background: var(--surface); padding: 22px; border: 1px solid var(--line); font-size: 12px; line-height: 1.8; color: #b8aa95; white-space: pre-line; }
+
+/* Detail Sidebar Actions */
+.detail-sidebar { display: flex; flex-direction: column; gap: 24px; position: sticky; top: 30px; }
+.action-card { padding: 30px; border: 1px solid var(--line); }
+.screening-card h3 { margin: 0 0 10px; font-size: 24px; letter-spacing: -.03em; }
+.screening-time { font-size: 12px; margin: 0 0 24px; }
+.ticket-price-tag { display: flex; align-items: baseline; gap: 8px; margin-bottom: 24px; }
+.price-amount { font-size: 36px; font-weight: 700; letter-spacing: -.04em; }
+.price-note { font-size: 11px; opacity: .8; }
+.booking-form { display: flex; flex-direction: column; gap: 16px; }
+.form-row { display: flex; flex-direction: column; gap: 8px; }
+.form-row label { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
+.seats-select { width: 100%; padding: 12px; background: var(--paper); border: 1px solid var(--line); color: var(--ink); font-family: inherit; font-size: 13px; outline: none; }
+.full-width { width: 100%; }
+.auth-prompt-card .panel-copy { margin-bottom: 16px; }
+
+.stream-card { background: var(--surface); }
+.stream-card h4 { margin: 0 0 8px; font-size: 18px; }
+.stream-card .panel-copy { margin-bottom: 20px; }
+.stream-button { background: var(--lime); color: var(--paper); font-weight: 600; }
+.stream-button span { font-size: 10px; margin-right: 4px; }
+
+/* Video Player View */
+.watch-container { max-width: 1240px; margin: 0 auto; padding: 40px 5vw 90px; }
+.watch-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
+.now-playing-tag { color: var(--lime); font-size: 12px; letter-spacing: .1em; }
+.video-player-wrapper { position: relative; width: 100%; aspect-ratio: 16/9; background: #000; border: 1px solid var(--line); overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,.6); }
+.film-video-element { width: 100%; height: 100%; object-fit: contain; background: #000; }
+.watch-meta-band { display: grid; grid-template-columns: 1fr 340px; gap: 5vw; margin-top: 40px; align-items: start; }
+.watch-meta-info h2 { font-size: 36px; margin: 0 0 8px; letter-spacing: -.04em; }
+.watch-director { color: #b8aa95; font-size: 14px; margin: 0 0 20px; }
+.watch-synopsis { font-size: 14px; line-height: 1.6; color: #d6cab6; max-width: 640px; }
+.watch-support-card { background: var(--surface); padding: 26px; border: 1px solid var(--line); }
+.watch-support-card h4 { margin: 0 0 8px; font-size: 18px; }
+
+/* My Tickets / Digital Reel */
+.tickets-container { max-width: 1100px; margin: 0 auto; padding: 60px 5vw 100px; }
+.tickets-header { margin-bottom: 50px; }
+.tickets-title { font-size: clamp(40px, 5vw, 64px); margin: 0 0 10px; letter-spacing: -.05em; }
+.ticket-list { display: flex; flex-direction: column; gap: 32px; }
+.cinema-pass-card { display: grid; grid-template-columns: 1fr 200px; border: 1px solid var(--line); background: var(--surface); overflow: hidden; box-shadow: 0 12px 30px rgba(0,0,0,.3); }
+.pass-stub-left { padding: 32px 36px; display: flex; flex-direction: column; justify-content: space-between; min-height: 260px; }
+.pass-brand-row { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: .12em; opacity: .85; margin-bottom: 20px; }
+.pass-film-title { font-size: 32px; margin: 0 0 6px; letter-spacing: -.04em; line-height: 1; }
+.pass-director { font-size: 13px; opacity: .9; margin: 0 0 24px; }
+.pass-meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 28px; margin-bottom: 28px; }
+.meta-item { display: flex; flex-direction: column; gap: 4px; }
+.meta-label { font-size: 10px; letter-spacing: .1em; opacity: .75; }
+.meta-val { font-size: 13px; font-weight: 500; }
+.pass-actions { display: flex; align-items: center; justify-content: space-between; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.15); }
+.pass-stream-link { font-size: 12px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
+.status-pill { font-size: 10px; letter-spacing: .08em; background: rgba(0,0,0,.3); padding: 5px 9px; }
+
+.pass-stub-right { background: #181310; border-left: 2px dashed var(--line); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 25px; text-align: center; gap: 12px; }
+.qr-container { width: 120px; height: 120px; background: #eadfcb; padding: 6px; display: grid; place-items: center; }
+.qr-label { font-size: 9px; letter-spacing: .14em; color: var(--lime); }
+.qr-token { font-size: 10px; color: #b8aa95; }
+.empty-tickets-card { text-align: center; padding: 80px 20px; border: 1px dashed var(--line); background: var(--surface); }
+.empty-tickets-card h2 { font-size: 32px; margin: 0 0 14px; }
+.empty-tickets-card .panel-copy { margin: 0 auto 30px; }
+
+@media (max-width: 860px) {
+    .detail-layout, .watch-meta-band { grid-template-columns: 1fr; }
+    .cinema-pass-card { grid-template-columns: 1fr; }
+    .pass-stub-right { border-left: 0; border-top: 2px dashed var(--line); padding: 30px 20px; }
+}
